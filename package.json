{
  "name": "copc-adapter-test",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev --workspace apps/vite-vanillajs --",
    "bootstrap": "node tools/matrix/cli.mjs bootstrap",
    "build": "npm run build:matrix",
    "build:bundlers": "npm run matrix -- build --apps webpack-three,rollup-cesium,esbuild-three,parcel-three",
    "preview": "npm run preview --workspace apps/vite-vanillajs --",
    "build:matrix": "node tools/matrix/cli.mjs build",
    "typecheck:matrix": "node tools/matrix/cli.mjs typecheck",
    "matrix:fast": "node tools/matrix/cli.mjs fast",
    "matrix:full": "node tools/matrix/cli.mjs full",
    "matrix:release": "node tools/matrix/cli.mjs release",
    "release:gate": "node tools/matrix/cli.mjs release-gate",
    "compatibility:consumer": "node tools/compatibility/runner.mjs",
    "typecheck:bundlers": "npm run matrix -- typecheck --apps webpack-three,rollup-cesium,esbuild-three,parcel-three",
    "test:contract": "npm run test --workspace @copc-test/test-contract",
    "test:fixtures": "npm run test --workspace @copc-test/fixture-server",
    "test:matrix": "npm run test:contract && npm run test:fixtures && node --experimental-strip-types --test tests/e2e/fixture-contract.test.ts && node --test tools/matrix/runner.test.mjs tools/matrix/runner.test.mjs tools/compatibility/manifest.test.mjs tools/compatibility/runner.test.mjs && npm run typecheck:matrix",
    "e2e": "playwright test",
    "e2e:fast": "COPC_E2E_MODE=fast playwright test",
    "e2e:full": "COPC_E2E_MODE=full playwright test",
    "e2e:visual": "COPC_E2E_MODE=visual playwright test tests/e2e/visual.spec.ts",
    "e2e:visual:update": "COPC_E2E_MODE=visual playwright test tests/e2e/visual.spec.ts --update-snapshots",
    "e2e:bundlers": "COPC_E2E_APPS=webpack-three,rollup-cesium,esbuild-three,parcel-three playwright test",
    "e2e:preview": "npm run build:matrix && COPC_E2E_TARGET=preview COPC_E2E_MODE=fast playwright test",
    "e2e:install": "playwright install chromium firefox webkit",
    "matrix": "node tools/matrix/cli.mjs",
    "fixtures": "node --experimental-strip-types tools/fixtures/cli.mjs",
    "fixtures:list": "npm run fixtures -- list",
    "fixtures:fetch": "npm run fixtures -- fetch",
    "fixtures:verify": "npm run fixtures -- verify",
    "fixtures:serve": "npm run fixtures -- serve",
    "fixtures:clean": "npm run fixtures -- clean",
    "dev:vite-vanillajs": "npm run dev --workspace apps/vite-vanillajs --",
    "dev:vite-vanilla-three": "npm run dev --workspace apps/vite-vanilla-three --",
    "dev:vite-react-cesium": "npm run dev --workspace apps/vite-react-cesium --",
    "dev:vite-react-three": "npm run dev --workspace apps/vite-react-three --",
    "dev:vite-r3f": "npm run dev --workspace apps/vite-r3f --",
    "dev:vite-vue-cesium": "npm run dev --workspace apps/vite-vue-cesium --",
    "dev:vite-vue-three": "npm run dev --workspace apps/vite-vue-three --",
    "dev:vite-svelte-cesium": "npm run dev --workspace apps/vite-svelte-cesium --",
    "dev:vite-svelte-three": "npm run dev --workspace apps/vite-svelte-three --",
    "dev:next-cesium": "npm run dev --workspace apps/next-cesium --",
    "dev:next-three": "npm run dev --workspace apps/next-three --",
    "dev:next-r3f": "npm run dev --workspace apps/next-r3f --",
    "dev:nuxt-cesium": "npm run dev --workspace apps/nuxt-cesium --",
    "dev:nuxt-three": "npm run dev --workspace apps/nuxt-three --",
    "dev:sveltekit-cesium": "npm run dev --workspace apps/sveltekit-cesium --",
    "dev:sveltekit-three": "npm run dev --workspace apps/sveltekit-three --",
    "dev:astro-cesium": "npm run dev --workspace apps/astro-cesium --",
    "dev:astro-three": "npm run dev --workspace apps/astro-three --",
    "dev:angular-cesium": "node tools/matrix/angular-dev.mjs angular-cesium",
    "dev:angular-three": "node tools/matrix/angular-dev.mjs angular-three"
  },
  "workspaces": [
    "packages/*",
    "apps/vite-vanillajs",
    "apps/vite-vanilla-three",
    "apps/vite-react-cesium",
    "apps/vite-react-three",
    "apps/vite-r3f",
    "apps/vite-vue-cesium",
    "apps/vite-vue-three",
    "apps/vite-svelte-cesium",
    "apps/vite-svelte-three",
    "apps/next-cesium",
    "apps/next-three",
    "apps/next-r3f",
    "apps/nuxt-cesium",
    "apps/nuxt-three",
    "apps/sveltekit-cesium",
    "apps/sveltekit-three",
    "apps/astro-cesium",
    "apps/astro-three",
    "apps/webpack-three",
    "apps/rollup-cesium",
    "apps/esbuild-three",
    "apps/parcel-three",
    "apps/angular-cesium",
    "apps/angular-three"
  ],
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@angular/cli": "^22.1.7",
    "@angular/build": "^22.1.7"
  },
  "@parcel/resolver-default": {
    "packageExports": true
  }
}
